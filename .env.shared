# Shared env schema for varlock (imported by app schemas)
# @currentEnv=$APP_ENV
# @defaultSensitive=false @defaultRequired=false
# ---

# Environment flag
# @type=enum(development, staging, production, test) @required
APP_ENV=development

# Port configurations
# @type=port @required=forEnv(development)
FRONTEND_PORT=5173
# @type=port @required=forEnv(development)
ADMIN_PORT=5174
# @type=port @required
MANAGER_PORT=5175
# @type=port @required
API_PORT=3000

# Shared URLs (derived from APP_ENV)
# @required
API_URL=ifs(
  forEnv(production, staging), MY_APP_API_URL,
  forEnv(development, test), "http://localhost:${API_PORT}",
  undefined
)
# @required
FRONTEND_URL=ifs(
  forEnv(production, staging), MY_APP_FRONTEND_URL, 
  forEnv(development, test), "http://localhost:${FRONTEND_PORT}",
  undefined
)
# @required
ADMIN_URL=ifs(
  forEnv(production, staging), MY_APP_ADMIN_URL, 
  forEnv(development, test), "http://localhost:${ADMIN_PORT}",
  undefined
)
# @required
MANAGER_URL=ifs(
  forEnv(production, staging), MY_APP_MANAGER_URL,
  forEnv(development, test), "http://localhost:${MANAGER_PORT}",
  undefined
)
