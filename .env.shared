# Shared environment schema consumed by Varlock.
# @currentEnv=$APP_ENV
# @defaultSensitive=false @defaultRequired=false
# ---

# @type=enum(development, staging, production, test) @required
APP_ENV=development

# @type=port @required
BACKEND_PORT=3000
# @type=port @required
FRONTEND_PORT=3001
# @type=port @required
MANAGER_PORT=3002
# @type=port @required
ADMIN_PORT=3003

# Exact deployed origins are supplied by the environment in staging and
# production. The derived public names below are consumed by the apps.
# @type=url @required=forEnv(production, staging)
MY_APP_BACKEND_URL=
# @type=url @required=forEnv(production, staging)
MY_APP_FRONTEND_URL=
# @type=url @required=forEnv(production, staging)
MY_APP_MANAGER_URL=
# @type=url @required=forEnv(production, staging)
MY_APP_ADMIN_URL=

# @type=url @required
BACKEND_URL=ifs(
  forEnv(production, staging), $MY_APP_BACKEND_URL,
  forEnv(development, test), "http://localhost:${BACKEND_PORT}",
  undefined
)

# @type=url @required=forEnv(production, staging)
FRONTEND_URL=ifs(
  forEnv(production, staging), $MY_APP_FRONTEND_URL,
  forEnv(development, test), "http://localhost:${FRONTEND_PORT}",
  undefined
)

# @type=url @required=forEnv(production, staging)
MANAGER_URL=ifs(
  forEnv(production, staging), $MY_APP_MANAGER_URL,
  forEnv(development, test), "http://localhost:${MANAGER_PORT}",
  undefined
)

# @type=url @required=forEnv(production, staging)
ADMIN_URL=ifs(
  forEnv(production, staging), $MY_APP_ADMIN_URL,
  forEnv(development, test), "http://localhost:${ADMIN_PORT}",
  undefined
)
