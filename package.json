{
  "name": "competition-manager-v2",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "type": "module",
  "scripts": {
    "docs:check": "bun scripts/check-traceability.ts",
    "build": "bun run env:generate && turbo run build",
    "check": "bun run env:generate && turbo run typecheck && bun run lint && bun run format:check",
    "db:deploy": "bun --filter=@competition-manager/backend prisma:migrate:deploy",
    "db:generate": "bun --filter=@competition-manager/backend prisma:generate",
    "db:migrate": "bun --filter=@competition-manager/backend prisma:migrate",
    "dev": "bun run env:generate && turbo run dev --ui=stream",
    "env:generate": "turbo run env:generate",
    "env:validate": "turbo run env:validate",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --type-check --react-plugin --vitest-plugin .",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration"
  },
  "dependencies": {
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "^1.2.21",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "prisma": "^6.19.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "^0.15.4",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.0",
  "catalog": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.0",
    "tsdown": "^0.15.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "varlock": "^1.3.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.7",
    "zod": "^4.6.2"
  }
}
