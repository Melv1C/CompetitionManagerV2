{
  "name": "@competition-manager/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "bun --watch src/index.ts",
    "env:generate": "varlock codegen",
    "env:validate": "varlock load",
    "test": "vitest run src",
    "start": "bun dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@competition-manager/backend-infrastructure": "workspace:*",
    "@competition-manager/contracts": "workspace:*",
    "@competition-manager/email": "workspace:*",
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
