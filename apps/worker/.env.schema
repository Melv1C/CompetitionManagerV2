# @import(../../.env.shared)
# @defaultSensitive=true @defaultRequired=true
# @generateTypes(lang=ts, path=env.d.ts)
# ---

# @type=enum(development, staging, production, test) @sensitive=false
NODE_ENV=$APP_ENV

# Database
# @type=url
DATABASE_URL=if(
  forEnv(development), postgresql://postgres:postgres@localhost:5432/postgres,
  undefined
)

# Redis and BullMQ
# @type=url
REDIS_URL=if(
  forEnv(development, test), redis://localhost:6379,
  undefined
)
