{
  "name": "@competition-manager/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "bun --watch src/index.ts",
    "env:generate": "varlock codegen",
    "env:validate": "varlock load",
    "prisma:format": "APP_ENV=development prisma format",
    "prisma:generate": "APP_ENV=development DATABASE_URL=\"${DATABASE_URL:-postgresql://competition:competition@localhost:5432/competition_manager}\" prisma generate",
    "prisma:migrate": "APP_ENV=development DATABASE_URL=\"${DATABASE_URL:-postgresql://competition:competition@localhost:5432/competition_manager}\" prisma migrate dev",
    "prisma:migrate:deploy": "APP_ENV=development DATABASE_URL=\"${DATABASE_URL:-postgresql://competition:competition@localhost:5432/competition_manager}\" prisma migrate deploy",
    "start": "bun dist/index.mjs",
    "test": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@competition-manager/backend-infrastructure": "workspace:*",
    "@competition-manager/contracts": "workspace:*",
    "@hono/node-server": "^2.0.4",
    "@prisma/client": "^6.19.3",
    "hono": "^4.12.23",
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "prisma": "^6.19.3",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
