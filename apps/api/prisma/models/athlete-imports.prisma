model AthleteImportBatch {
  id                String             @id @default(uuid()) @db.Uuid
  provider          String
  filename          String
  checksum          String
  state             AthleteImportState @default(PREVIEW)
  seasonCode        String
  seasonStartsOn    DateTime           @db.Date
  seasonEndsOn      DateTime           @db.Date
  athleticsSeasonId String?            @db.Uuid
  athleticsSeason   AthleticsSeason?   @relation(fields: [athleticsSeasonId], references: [id], onDelete: Restrict)
  createdByUserId   String?
  createdBy         User?              @relation("AthleteImportCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  summary           Json
  errorMessage      String?
  workerJobId       String?
  confirmedAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  stagingExpiresAt  DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  rows  AthleteImportRow[]
  clubs AthleteImportClub[]

  @@index([provider, seasonCode, state])
  @@index([createdAt])
  @@map("athlete_import_batch")
}

model AthleteImportRow {
  id               String             @id @default(uuid()) @db.Uuid
  importBatchId    String             @db.Uuid
  importBatch      AthleteImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  sourceRow        Int
  license          String
  bib              Int
  firstName        String
  lastName         String
  gender           String
  birthDate        DateTime           @db.Date
  clubExternalId   String
  clubAbbreviation String

  @@unique([importBatchId, license])
  @@index([importBatchId, clubExternalId])
  @@map("athlete_import_row")
}

model AthleteImportClub {
  id            String             @id @default(uuid()) @db.Uuid
  importBatchId String             @db.Uuid
  importBatch   AthleteImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  externalId    String
  name          String
  abbreviation  String
  countryCode   String             @db.Char(2)
  active        Boolean            @default(true)

  @@unique([importBatchId, externalId])
  @@map("athlete_import_club")
}

model AthleteMerge {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  deletedAthleteId   String       @db.Uuid
  survivingAthleteId String       @db.Uuid
  survivingAthlete   Athlete      @relation("SurvivingAthlete", fields: [survivingAthleteId], references: [id], onDelete: Restrict)
  deletedIdentity    Json
  reason             String
  actorUserId        String?
  actor              User?        @relation("AthleteMergeActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  mergedAt           DateTime     @default(now())

  @@index([organizationId, mergedAt])
  @@index([survivingAthleteId])
  @@map("athlete_merge")
}
