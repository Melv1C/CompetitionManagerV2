{
  "name": "@competition-manager/backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/server.js",
    "worker": "bun src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --passWithNoTests tests/integration"
  },
  "dependencies": {
    "@competition-manager/config-env": "workspace:*",
    "@competition-manager/contracts": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.8.12",
    "pg": "^8.16.3",
    "redis": "^5.8.2"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  }
}
